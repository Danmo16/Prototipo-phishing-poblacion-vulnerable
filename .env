# Example environment configuration for the phishing prototype
# Copy this file to `.env` and fill in the values before running the application.

# Secret key used for signing JWT tokens and other sensitive operations
SECRET_KEY=super-secret-key

# Database connection string (SQLAlchemy format)
# For local development you can use SQLite: sqlite:///./database.db
DATABASE_URL=postgresql+psycopg2://phishing_user:phishing_pass@localhost:5432/phishing  #sqlite:///./data/sqlite/phishing_sqlite.db

# SMTP settings for sending emails (used by the email channel)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_USE_TLS=true

# Tracker / outbox
TRACKER_BASE_URL=http://127.0.0.1:8001
OUTBOX_DIR=data/outbox

# Redis broker URL for Celery workers (used by the worker service)
REDIS_URL=redis://localhost:6379/0

# Application host and port configuration
API_HOST=0.0.0.0
API_PORT=8000

# SMTP provider configuration
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Simulación Académica
DELIVERY_MODE=smtp #Modo simulado = simulated_outbox / SMTP real = smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=soulconfusion16@gmail.com
SMTP_PASSWORD=zsxw sfob rfmm bndw
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=soulconfusion16@gmail.com
SMTP_FROM_NAME=Simulación Académica

# Other channel-specific configurations can be added as needed